{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // Madang (https://madang.party)
  // 클라우드플레어 Workers 하나로 화면(정적 파일)과 협업 서버(API · 실시간 연결)를 함께 제공한다.
  "name": "madang",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // 배포하면 클라우드플레어가 도메인 연결(DNS)과 HTTPS 인증서를 자동으로 처리한다
  "routes": [{ "pattern": "madang.party", "custom_domain": true }],
  // 주소를 하나로 유지: 개인 공간 데이터는 주소(origin)마다 따로 저장되므로 *.workers.dev 주소는 끈다
  "workers_dev": false,
  // 대시보드에서 추가한 변수를 배포할 때 지우지 않는다 (로그인 설정은 Secret으로 넣는 것을 권장)
  "keep_vars": true,
  "preview_urls": false,
  "assets": {
    "directory": "../client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /api 요청과 초대 링크(미리보기 카드)만 Worker 코드가 처리하고, 나머지는 정적 파일로 바로 응답
    "run_worker_first": ["/api/*", "/join/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "DIRECTORY", "class_name": "Directory" },
      { "name": "ROOM", "class_name": "TemplateRoom" }
    ]
  },
  // 무료 요금제에서는 SQLite 저장소를 쓰는 Durable Object만 사용할 수 있다
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Directory", "TemplateRoom"] }],
  "observability": { "enabled": true }
}
