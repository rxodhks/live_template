# 클라우드플레어 정적 파일(화면) 응답 헤더 · /api/*, /join/*은 Worker 코드가 직접 응답한다
/*
  # 다른 사이트가 이 앱을 투명한 프레임으로 겹쳐 놓고 클릭을 유도하지 못하게 (클릭재킹)
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# /assets/ 파일과 /runtimes/<id>-<해시>/ 폴더는 이름에 내용 해시가 붙어 바뀌지 않으므로
# 브라우저가 1년 동안 다시 묻지 않고 쓴다. index.html 등 나머지는 기본값(매번 확인)을 유지해
# 배포하면 바로 새 화면이 나온다.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/runtimes/*
  Cache-Control: public, max-age=31536000, immutable
